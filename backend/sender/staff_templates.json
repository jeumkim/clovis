[
  {
    "id": "reply",
    "label": "메일 회신",
    "description": "받은 메일에 대해 확정된 사실만으로 격식 있는 회신 초안을 만듭니다.",
    "primary": true,
    "default": true,
    "badge": "가장 많이 쓰는 기능",
    "subject_prefix": "Re: ",
    "intro_text": "받은 메일을 그대로 붙여넣으세요",
    "sub_text": "문의와 요청을 정리해 격식 있는 회신 초안으로 바꿉니다",
    "submit_label": "회신 초안 만들기",
    "rules": "수신 원문은 참고용으로만 사용하고 본문에 그대로 반복하지 않습니다. 회신 목적에 맞춰 답변 내용을 자연스러운 문장으로 정리합니다.",
    "fields": [
      {
        "id": "received_mail",
        "label": "수신 메일 원문",
        "type": "textarea",
        "required": true,
        "placeholder": "받은 메일의 제목과 본문을 그대로 붙여넣으세요.\n예)\n제목: 커피 납품 일정 문의\n안녕하세요, 다음 주 납품 일정 확인 부탁드립니다.",
        "rows": 8
      },
      {
        "id": "reply_purpose",
        "label": "회신 목적",
        "type": "select",
        "required": true,
        "default": "자동 구성",
        "options": ["자동 구성", "수신 확인", "요청 승인", "일정 안내", "자료 전달", "추가 문의", "정중한 거절"]
      },
      {
        "id": "confirmed_content",
        "label": "답변에 넣을 내용",
        "type": "textarea",
        "required": true,
        "placeholder": "확정된 사실만 짧게 입력하세요.\n예) 8월 14일까지 회신 가능",
        "rows": 4
      },
      { "id": "to", "label": "받는 사람", "type": "text", "required": false, "placeholder": "예) 홍길동 대리" },
      { "id": "cc", "label": "참조", "type": "text", "required": false, "placeholder": "예) 물류1팀" },
      { "id": "from_org", "label": "내 소속", "type": "text", "required": true, "placeholder": "예) 물류운영팀" },
      { "id": "from_name", "label": "발신자", "type": "text", "required": true, "placeholder": "예) 김철수" }
    ]
  },
  {
    "id": "report",
    "label": "업무보고",
