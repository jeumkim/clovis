      { "id": "request_detail", "label": "요청 세부 내용", "type": "textarea", "required": true, "placeholder": "예) 9월 3주차 선적 가능 여부 확인", "rows": 3 },
      { "id": "deadline", "label": "요청 기한", "type": "text", "required": false, "placeholder": "예) 8월 20일" },
