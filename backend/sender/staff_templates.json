      { "id": "in_progress_tasks", "label": "진행 업무", "type": "textarea", "required": false, "placeholder": "예) 9월 물류비 검토", "rows": 3 },
      { "id": "planned_tasks", "label": "예정 업무", "type": "textarea", "required": false, "placeholder": "예) 10월 계약 갱신 검토", "rows": 3 },
      { "id": "request_content", "label": "확인·지원 요청 사항", "type": "textarea", "required": false, "placeholder": "예) 정산 자료 최종 확인", "rows": 3 },
      { "id": "to", "label": "받는 사람", "type": "text", "required": false, "placeholder": "예) 박부장" },
