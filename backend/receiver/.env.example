# backend/receiver 로컬 개발용 설정 템플릿.
#
# 이 파일을 복사해 .env로 저장하고 값을 채우세요. 실제 값이 든 .env는
# 절대 커밋하지 않습니다(.gitignore에 등록되어 있음).
#
# 프로덕션에서는 이 값들을 코드에 두지 않고 사내 Secret Manager에서
# 주입합니다(secret_manager.py의 get_openai_config() 참고). 이 파일은
# 로컬 개발 편의를 위한 템플릿일 뿐입니다.

# 비어 있으면 mock_extract_email_fields 경로(로컬 테스트/폴백)가 쓰입니다.
OPENAI_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# SQLite DB 파일 경로를 바꾸고 싶을 때만 설정하세요.
# 기본값: backend/receiver/data/receiver.db
# RECEIVER_DB_PATH=
